POSTGRES_DB=ams
POSTGRES_USER=ams_app
POSTGRES_PASSWORD=ams_app_local
POSTGRES_PORT=5432

AMS_DATABASE_URL=postgresql+asyncpg://ams_app:ams_app_local@localhost:5432/ams
AMS_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
AMS_JWT_ISSUER=ams-api
AMS_JWT_AUDIENCE=ams-web
AMS_ACCESS_TOKEN_MINUTES=15
AMS_REFRESH_TOKEN_DAYS=7
AMS_REFRESH_COOKIE_SECURE=false
AMS_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
AMS_LOG_LEVEL=INFO
AMS_EVIDENCE_STORAGE_ROOT=.private/evidence
