# Tuỳ chọn cho môi trường local. Các giá trị dưới đây đều đã có default trong compose.yaml.
POSTGRES_DB=ams
POSTGRES_USER=ams_app
POSTGRES_PASSWORD=ams_app_local
POSTGRES_PORT=5432

API_PORT=8000
WEB_PORT=5173
AMS_JWT_SECRET=local-development-secret-change-before-production-2026
AMS_LOG_LEVEL=INFO

# true: UI demo dùng dữ liệu mock và tài khoản baotran/123456.
# false: UI gọi backend thật qua Nginx; cần chuẩn bị user và dữ liệu trong PostgreSQL.
VITE_USE_MOCK=true
VITE_API_BASE_URL=/api/v1
