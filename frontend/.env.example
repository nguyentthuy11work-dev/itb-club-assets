# Đường dẫn gốc của backend API thật.
# Khi để trống, ứng dụng sẽ tự dùng MOCK API (dữ liệu giả lập trong src/api/mockServer.js)
# để bạn xem giao diện chạy được ngay cả khi chưa có backend.
#
# Ví dụ khi đã có backend:
# VITE_API_BASE_URL=https://api.clbassets.vn/api/v1
VITE_API_BASE_URL=

# Bật/tắt mock API một cách tường minh (true/false).
# Nếu không set, hệ thống tự bật mock khi VITE_API_BASE_URL rỗng.
VITE_USE_MOCK=true
